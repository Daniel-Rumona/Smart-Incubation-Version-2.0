GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENT_SHARED_SECRET=
WHATSAPP_ROUTER_SECRET=
DOCUMENT_SIGNING_SECRET=
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Use FIREBASE_SERVICE_ACCOUNT_B64 instead when multiline JSON is inconvenient.
FIREBASE_SERVICE_ACCOUNT_B64=

# Pitch Coach (Pitchfy) integration. Keep PITCHFY_API_KEY on the backend only.
PITCHFY_API_KEY=pf_live_replace_me
PITCHFY_BASE_URL=https://rairo-pitch-helper-api.hf.space

# Development only. Never set this to true in production.
ALLOW_UNAUTHENTICATED_AGENT_API=false

# Voice output for the agentic home's conversation mode (ElevenLabs). Keep
# ELEVENLABS_API_KEY on the backend only — it never reaches the client.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Agentic operations (appointments / interventions via Q). Set false to disable the tool path.
AGENT_ACTIONS_ENABLED=true
# Timezone used to read times like "tomorrow at 10:00" and to show times back to users.
AGENT_TIMEZONE=Africa/Johannesburg
