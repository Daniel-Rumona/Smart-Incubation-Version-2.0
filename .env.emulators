# Local Firebase emulators only (`npm run dev:emulators`). Not secrets: a `demo-` project never reaches a real
# Firebase project, so these values only work against the emulators started by `npm run emulators`.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-smartinc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-smartinc
VITE_FIREBASE_STORAGE_BUCKET=demo-smartinc.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_USE_FIREBASE_EMULATORS=true
VITE_FUNCTIONS_BASE_URL=http://127.0.0.1:5001/demo-smartinc/us-central1
VITE_AGENT_API_BASE_URL=http://127.0.0.1:8000
